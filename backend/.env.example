# HireLoop Backend Environment Configuration
PROJECT_NAME="HireLoop API"
ENVIRONMENT="development"
PORT=8000

# Database
# Production / Local Postgres:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hireloop_db"
# Local quick-start fallback:
# DATABASE_URL="sqlite:///./hireloop.db"

# Security & Auth
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Service (LLM API: Gemini, Anthropic, or OpenAI)
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Allowed CORS Origins (Frontend Vite dev server default)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"
